{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-routing-response.schema.json",
  "title": "Suggest-only response (POST /v1/model-routing, 200)",
  "type": "object",
  "required": ["id", "object", "created", "router", "ranked"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "object": { "const": "model_routing" },
    "created": { "type": "integer", "minimum": 0 },
    "router": { "$ref": "common.schema.json#/$defs/router" },
    "ranked": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "common.schema.json#/$defs/ranked_entry" }
    }
  }
}
