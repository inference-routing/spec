{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chat-completion-request.schema.json",
  "title": "Proxy-mode request (POST /v1/chat/completions)",
  "description": "An OpenAI Chat Completions request with an optional routing member.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/inference_request" }],
  "properties": {
    "routing": {
      "type": "object",
      "properties": {
        "cqt": { "$ref": "common.schema.json#/$defs/cqt" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "common.schema.json#/$defs/candidate_ref" }
        }
      }
    }
  }
}
