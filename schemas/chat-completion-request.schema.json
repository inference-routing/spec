{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chat-completion-request.schema.json",
  "title": "Proxy-mode request (POST /v1/chat/completions)",
  "description": "An OpenAI Chat Completions request with an optional routing member.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/inference_request"
    }
  ],
  "properties": {
    "routing": {
      "type": "object",
      "properties": {
        "cost_quality_tradeoff": {
          "$ref": "common.schema.json#/$defs/cost_quality_tradeoff"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "common.schema.json#/$defs/candidate_ref"
          }
        },
        "extra": {
          "$ref": "common.schema.json#/$defs/extra"
        }
      }
    }
  }
}
