{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rank-request.schema.json",
  "title": "Suggest-only request (POST /v1/routing/rank)",
  "type": "object",
  "required": [
    "request",
    "routing"
  ],
  "properties": {
    "request": {
      "$ref": "common.schema.json#/$defs/inference_request"
    },
    "routing": {
      "type": "object",
      "required": [
        "candidates"
      ],
      "properties": {
        "cost_quality_tradeoff": {
          "$ref": "common.schema.json#/$defs/cost_quality_tradeoff"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "common.schema.json#/$defs/candidate"
          }
        },
        "extra": {
          "$ref": "common.schema.json#/$defs/extra"
        }
      }
    }
  }
}
